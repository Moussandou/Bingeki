rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPER FUNCTIONS ====================

    // User is authenticated
    function isAuthenticated() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid))
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('deleting', false) != true));
    }

    // User matches the requested document ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the user is an Admin
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Check if the user is a Super Admin (PO)
    function isSuperAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isSuperAdmin', false) == true;
    }

    // Check if the requester can view the target user's private/protected content
    function isAcceptedFriend(userId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)).data.status == 'accepted';
    }

    function canViewProfile(userId, profile) {
      let visibility = profile.get('profileVisibility', 'public');
      return isOwner(userId) || 
             isAdmin() || 
             visibility == 'public' || visibility == null ||
             (visibility == 'friends' && isAcceptedFriend(userId));
    }

    function canViewUserContent(userId) {
      return canViewProfile(userId, get(/databases/$(database)/documents/users/$(userId)).data);
    }

    // Every third-party entry must stay unchanged.
    function ownParticipantChange() {
      let before = resource.data.participants;
      let after = request.resource.data.participants;
      let removed = before.removeAll(after);
      let added = after.removeAll(before);
      return before is list && after is list
        && after.toSet().size() == after.size()
        && removed.size() <= 1 && added.size() <= 1
        && (removed.size() == 0 || removed[0].id == request.auth.uid)
        && (added.size() == 0 || added[0].id == request.auth.uid);
    }

    function acceptingChallengeInvitation() {
      let removed = resource.data.participants.removeAll(request.resource.data.participants);
      let added = request.resource.data.participants.removeAll(resource.data.participants);
      return removed.size() == 1 && added.size() == 1
        && removed[0].status == 'pending' && added[0].status == 'accepted';
    }

    function ownLikesChange() {
      let before = resource.data.get('likes', []);
      let after = request.resource.data.likes;
      return after is list && after.size() <= before.size() + 1
        && after.toSet().size() == after.size()
        && after.removeAll([request.auth.uid]) == before.removeAll([request.auth.uid]);
    }

    function validBonusXp() {
      return request.resource.data.bonusXp is int
        && request.resource.data.bonusXp >= 0
        && request.resource.data.bonusXp <= 50000;
    }

    function validGamification() {
      return validBonusXp() && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 36500;
    }

    // ==================== USERS COLLECTION ====================

    match /users/{userId} {
      // Discovery must constrain visibility; targeted reads can include accepted friends.
      allow get: if canViewProfile(userId, resource.data);
      allow list: if resource.data.profileVisibility == 'public'
        || isOwner(userId) || isAdmin()
        || (resource.data.profileVisibility == 'friends' && isAcceptedFriend(userId));
      
      // Write:
      // 1. Owner can update their profile (bio, theme, etc.)
      // 2. Admin can moderate ordinary profiles; only super-admins manage super-admins.
      // 3. Prevent Owner from modifying their own 'isAdmin', 'isBanned', or 'createdAt' flags
      // Server-managed gamification stats: written ONLY by the onLibraryUpdate
      // Cloud Function (Admin SDK, bypasses these rules) and read by the leaderboard.
      // Clients must never write them directly, or they could inflate their rank.
      allow update: if (isOwner(userId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'uid', 'isAdmin', 'isSuperAdmin', 'isBanned', 'createdAt', 'deleting', 'communityXp', 'communityTitle',
                          'level', 'xp', 'totalXp', 'xpToNextLevel', 'streak', 'badges',
                          'totalChaptersRead', 'totalAnimeEpisodesWatched', 'totalMoviesWatched',
                          'totalWorksAdded', 'totalWorksCompleted', 'bonusXp',
                          'lastUpdated', 'lastActivityDate'
                        ]))
                    || (isAdmin()
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'uid', 'isSuperAdmin', 'deleting', 'communityXp', 'communityTitle',
                          'level', 'xp', 'totalXp', 'xpToNextLevel', 'streak', 'badges',
                          'totalChaptersRead', 'totalAnimeEpisodesWatched', 'totalMoviesWatched',
                          'totalWorksAdded', 'totalWorksCompleted', 'bonusXp',
                          'lastUpdated', 'lastActivityDate'
                        ])
                        && (!resource.data.get('isSuperAdmin', false) || isSuperAdmin()))
                    || (isSuperAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isSuperAdmin', 'isAdmin']));

      // Create: same protected-fields list as update (no self-granted isAdmin/XP).
      // Account deletion goes through the cleanup callable (Admin SDK).
      allow create: if isOwner(userId)
                    && request.resource.data.get('uid', userId) == userId &&
                    !request.resource.data.keys().hasAny([
                      'isAdmin', 'isSuperAdmin', 'isBanned', 'deleting', 'communityXp', 'communityTitle',
                      'level', 'xp', 'totalXp', 'xpToNextLevel', 'streak', 'badges',
                      'totalChaptersRead', 'totalAnimeEpisodesWatched', 'totalMoviesWatched',
                      'totalWorksAdded', 'totalWorksCompleted', 'bonusXp',
                      'lastUpdated', 'lastActivityDate'
                    ]);
      allow delete: if isAdmin() && (!resource.data.get('isSuperAdmin', false) || isSuperAdmin());
      
      // --- Subcollection: Data (Library & Gamification) ---
      
      // 1. Gamification Data - SERVER-SIDE ONLY
      match /data/gamification {
        allow read: if canViewUserContent(userId);

        // Split ownership:
        //  - client owns bonusXp / streak / lastActivityDate only
        //  - every derived stat (level, xp, totalXp, counters, badges) is written
        //    exclusively by the Cloud Functions via the Admin SDK, which bypasses
        //    these rules. A client that could write them could inflate its rank,
        //    and — just as bad — could block the server from correcting it.
        allow update: if (isOwner(userId) &&
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                            'level', 'xp', 'totalXp', 'xpToNextLevel', 'badges',
                            'totalChaptersRead', 'totalAnimeEpisodesWatched', 'totalMoviesWatched',
                            'totalWorksAdded', 'totalWorksCompleted',
                            'verifiedStreak', 'verifiedStreakAt', 'communityXp'
                          ]) &&
                          validGamification() &&
                          // Monotonic, except an exact reset to 0 (the "erase my data"
                          // button). Going to zero only ever hurts the owner.
                          // A doc created by the server trigger has no bonusXp yet:
                          // count it as 0, or the comparison errors and denies every write.
                          (request.resource.data.bonusXp == 0 || (
                            request.resource.data.bonusXp >= resource.data.get('bonusXp', 0) &&
                            request.resource.data.bonusXp <= resource.data.get('bonusXp', 0) + 1000
                          )) &&
                          request.resource.data.streak <= resource.data.get('streak', 0) + 365
                        ) || (isAdmin() && validBonusXp()
                              && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['bonusXp', 'lastUpdated']));

        allow delete: if isAdmin();

        // Owner Create: initial setup only, and never with derived fields prefilled.
        allow create: if (isOwner(userId) &&
                          validGamification() &&
                          request.resource.data.bonusXp <= 1000 &&
                          request.resource.data.streak <= 365 &&
                          !request.resource.data.keys().hasAny([
                            'level', 'xp', 'totalXp', 'xpToNextLevel', 'badges',
                            'totalChaptersRead', 'totalAnimeEpisodesWatched', 'totalMoviesWatched',
                            'totalWorksAdded', 'totalWorksCompleted',
                            'verifiedStreak', 'verifiedStreakAt', 'communityXp'
                          ]))
                        || (isAdmin() && validBonusXp()
                            && request.resource.data.keys().hasOnly(['bonusXp', 'lastUpdated']));
      }

      // 2. Library Data - Standard Access
      match /data/library {
        // Shared access uses getSharedLibraryFn, which strips private fields and folders.
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // 3. Other Data - Closed by default for security
      // If you add more documents to /data/, add them explicitly above.

      // --- Subcollection: Friends (Server-side managed) ---
      match /friends/{friendId} {
        // Read: Owner can see their own friends list
        allow read: if isOwner(userId);
        // Write: BLOCKED for clients. All friend management
        // (send/accept/reject) goes through Cloud Functions.
        // Admin SDK bypasses these rules.
      }
      
      // --- Subcollection: Notifications ---
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      // FCM tokens are owner-readable only; all authority belongs to callables.
      match /pushDevices/{installationId} {
        allow read: if isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
        allow write: if false;
      }

      // --- Subcollection: Private (PII) ---
      // Holds email and other profile PII (never FCM tokens) that must NOT live
      // on the world-readable profile document. Only the owner or an admin may read it.
      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

    }

    // ==================== FEATURES ====================

    // Read/write through authenticated callables: they enforce live profile
    // visibility, bilateral blocks and spoiler-safe serialization.
    match /communityPosts/{path=**} {
      allow read, write: if false;
    }
    match /communityState/{id} {
      allow read, write: if false;
    }
    match /communityWeeks/{id} {
      allow read, write: if false;
    }
    match /communityReports/{id} {
      allow read, write: if false;
    }
    match /communityVisits/{id} {
      allow read, write: if false;
    }

    // FEEDBACK
    match /feedback/{feedbackId} {
      // Guests may submit feedback (the form exposes an email field when logged out),
      // but an anonymous submission must not claim a userId it cannot prove.
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid)
                    || (request.auth == null
                        && request.resource.data.get('userId', null) == null
                        && request.resource.data.message is string
                        && request.resource.data.message.size() > 0
                        && request.resource.data.message.size() <= 5000);
      // Users can read their own feedback, Admins can read all
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      // Only Admins can update/delete (Resolution)
      allow update, delete: if isAdmin();
    }

    // WATCH PARTIES
    match /watchparties/{partyId} {
      allow read: if true;
      // Group invitations are validated by createWatchPartyFn.
      allow create: if false;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.hostId == resource.data.hostId
          && request.resource.data.status in ['active', 'paused', 'ended']
          && ((resource.data.hostId == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'currentEpisode', 'lastActivity', 'status']))
              || (resource.data.status != 'ended'
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'lastActivity'])
                  && ownParticipantChange())))
      );
      allow delete: if isAuthenticated() && (resource.data.hostId == request.auth.uid || isAdmin());
    }

    // ACTIVITY FEED (Server-side managed)
    match /activities/{activityId} {
      // Read: Authenticated users can view the feed IF:
      // 1. They are the owner or an admin
      // 2. OR the activity is explicitly marked as visible (isVisible == true)
      //    AND the profile visibility matches (Public OR is a Friend)
      // Read: Feed access logic
      // 1. Owner or Admin can always read.
      // 2. Others can read if the activity is visible AND the profile is public or they are friends.
      allow read: if isOwner(resource.data.userId) || isAdmin()
        || (resource.data.get('isVisible', true) != false
            && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('showActivityStatus', true) != false
            && canViewUserContent(resource.data.userId));
      
      // Write: BLOCKED for clients, except for owners deleting their own logs.
      allow create, update: if false; 
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // COMMENTS
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('likes', []).size() == 0;
      // Any signed-in user may like/unlike, but the ONLY field they can touch on a
      // comment they don't own is `likes`, and only to add/remove their own uid.
      function isLikeToggleOnly() {
        return isAuthenticated()
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
               && ownLikesChange();
      }
      // Allow author or Admin to update/delete; everyone else only toggles their like
      allow update: if (isOwner(resource.data.userId)
                         && request.resource.data.userId == resource.data.userId
                         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes']) || ownLikesChange()))
                    || isAdmin()
                    || isLikeToggleOnly();
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // CHALLENGES
    // Group challenges: the creator owns the doc, invited friends may accept/decline
    // and report their own progress. participantIds drives the "my challenges" query.
    match /challenges/{challengeId} {
      allow read: if isAuthenticated()
                  && (request.auth.uid in resource.data.participantIds || isAdmin());
      // The callable validates every invitation, without imposing a two-player limit.
      allow create: if false;
      // Creator can manage the challenge; participants may only update the
      // mutable gameplay fields (their progress / invitation status).
      allow update: if isAuthenticated() && (
                      isAdmin()
                      || (resource.data.createdBy == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['title', 'status', 'endDate', 'winnerId'])
                          && (!request.resource.data.keys().hasAny(['winnerId'])
                              || ((request.resource.data.winnerId == null || request.resource.data.winnerId in resource.data.participantIds)
                                  && request.resource.data.status == 'completed')))
                      || (request.auth.uid in resource.data.participantIds
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['participants', 'participantIds', 'status'])
                          && (request.resource.data.participantIds == resource.data.participantIds
                              || request.resource.data.participantIds == resource.data.participantIds.removeAll([request.auth.uid]))
                          && (request.resource.data.status == resource.data.status
                              || (resource.data.status in ['pending', 'active']
                                  && request.resource.data.status in ['pending', 'active']
                                  && acceptingChallengeInvitation()))
                          && ownParticipantChange())
                    );
      allow delete: if isAuthenticated()
                    && (resource.data.createdBy == request.auth.uid || isAdmin());
    }
    
    // ==================== GLOBAL CONFIGURATION ====================
    
    // GLOBAL CONFIG (for announcements, maintenance mode, etc.)
    match /config/{configId} {
      // Allow everyone to read global config (needed for maintenance mode)
      allow read: if true;
      // Only admins can update global config
      allow write: if isAdmin();
    }

    // TIER LISTS
    match /tierLists/{tierListId} {
      // Public lists readable by anyone; private lists only by their author or an admin
      allow read: if resource.data.isPublic == true
                  || (isAuthenticated() && resource.data.userId == request.auth.uid)
                  || isAdmin();

      // Create: Authenticated users can create their own lists
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('likes', []).size() == 0
        && request.resource.data.get('likesCount', 0) == 0;

      // Update: Author (full edit) or Admin, or any auth user for likes-only toggle
      allow update: if isAdmin()
                    || (isOwner(resource.data.userId)
                        && request.resource.data.userId == resource.data.userId
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'likesCount']))
                    || (isAuthenticated() &&
                        (resource.data.isPublic == true || isOwner(resource.data.userId))
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likesCount'])
                        && request.resource.data.likesCount == request.resource.data.likes.size()
                        && ownLikesChange());

      // Delete: Author or Admin only
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }
    
    // NEWS
    match /news/{newsId} {
      // Public read access for SEO and non-logged users
      allow read: if true;
      // Write access is only allowed for Admin users or the service account
      allow write: if isAdmin();
    }
    
    // SURVEYS
    match /survey_responses/{responseId} {
      allow read: if isAdmin();
      allow create: if true; // Public can submit
      allow update, delete: if isAdmin();
    }

    match /survey_waitlist/{entryId} {
      allow read: if isAdmin();
      allow create: if true; // Public can join waitlist
      allow update, delete: if isAdmin();
    }

    // HEALTH HISTORY
    match /admin_health_history/{historyId} {
      // Only admins can read/write health history
      allow read, write: if isAdmin();
    }

    // REPAIR HISTORY
    match /admin_repair_history/{historyId} {
      // Only admins can read/write repair history (from self-healing scans)
      allow read, write: if isAdmin();
    }

    // ADMIN AUDIT LOG
    match /adminAuditLog/{logId} {
      // Only admins can read/write admin audit logs
      allow read, write: if isAdmin();
    }

    // ==================== API CACHE (Cloud Functions only) ====================

    // Shared Jikan API cache — readable by all, writable only by Cloud Functions (Admin SDK)
    match /apiCache/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Automated translations collection.
    // Clients may REQUEST a translation (write input/source metadata) but must never
    // write the rendered payload — that is served to every visitor and is filled by
    // the onTranslationRequest Cloud Function (Admin SDK bypasses these rules).
    // `translatedInput`/`translatedAt` are the function's bookkeeping and are locked
    // down too, so a client cannot forge provenance for a payload it did not produce.
    match /translations/{docId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && !request.resource.data.keys().hasAny(['translated', 'translatedInput', 'translatedAt']);
      allow update: if isAuthenticated()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['translated', 'translatedInput', 'translatedAt']);
      allow delete: if isAdmin();
    }

    // ==================== ORGA (INTERNAL TEAM MANAGEMENT) ====================

    // Sprints: read by any admin, managed by superAdmin
    match /orga_sprints/{id} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // Tasks: read/create by any admin, update by owner or superAdmin, delete by superAdmin
    match /orga_tasks/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isSuperAdmin()
        || (isAdmin() && resource.data.assigneeUid == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // Events: read by any admin, managed by superAdmin
    match /orga_events/{id} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ==================== SOCIAL BOT ====================

    // Pending posts: created by Cloud Functions (server writes bypass rules),
    // read + updated + deleted by any admin (for validation via /admin/social).
    match /social_pending_posts/{id} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if false; // server-only (Cloud Functions)
    }

    // Published posts: read by any admin, written only by Cloud Functions
    // once a post has been actually published to Instagram/TikTok.
    match /social_published_posts/{id} {
      allow read: if isAdmin();
      allow write: if false; // server-only (Cloud Functions)
    }

    // Bot config (singleton doc): read by any admin, kill-switch and
    // schedule tweaks by superAdmin only. Platform tokens live in
    // Secret Manager, never here.
    match /social_bot_config/{id} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // Cron health (one doc per cron + `_watchdog`): written by the crons,
    // read by any admin for the Santé panel.
    match /social_cron_health/{id} {
      allow read: if isAdmin();
      allow write: if false; // server-only (Cloud Functions)
    }

    // Admin audit trail: written server-side (from callables) whenever
    // an admin rejects/publishes/regenerates a post. Read-only for admins.
    match /social_admin_audit/{id} {
      allow read: if isAdmin();
      allow write: if false; // server-only via callables
    }

    // ==================== LEGACY / ROOT ACCESS ====================
    match /pushTokenBindings/{tokenHash} {
      allow read, write: if false;
    }
    match /pushDeviceState/{userId} {
      allow read, write: if false;
    }

    // DELETED: Legacy root collections removed for security.
    // All data must go through users/{userId}/data/ subcollections.
  }
}
