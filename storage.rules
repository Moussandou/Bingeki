rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper: Is authenticated
    function isAuthenticated() {
      return request.auth != null
        && !firestore.exists(/databases/(default)/documents/accountDeletions/$(request.auth.uid))
        && (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            || (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true
                && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('deleting', false) != true));
    }

    function validImage() {
      return request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/avif'];
    }

    // Helper: Is admin
    function isAdmin() {
      return isAuthenticated() && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Feedback Attachments
    // Path: feedback-attachments/{ticketRef}/{filename}
    // NOTE: `ticketRef` is a client-generated temp id chosen BEFORE the feedback doc
    // exists, so it can never be resolved back to a /feedback document. The previous
    // read rule did exactly that lookup and therefore always denied. Access is instead
    // carried by the signed download token embedded in the stored URL.
    match /feedback-attachments/{ticketRef}/{allPaths=**} {
      // Guests can report bugs (see /feedback rules), so they must be able to attach
      // the screenshot that goes with it. Constrained to modest image uploads.
      allow create: if resource == null && (request.auth == null || isAuthenticated()) && validImage();
      // Rendering happens through the tokenized download URL saved on the ticket,
      // which bypasses these rules — so direct path access stays admin-only.
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // ADMIN BUCKET LISTING (for health checks)
    allow list: if isAdmin();

    // Existing rules for other paths...
    match /avatars/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.auth.uid == userId && validImage();
      allow delete: if isAuthenticated() && request.auth.uid == userId;
      // Allow authenticated users to list files in avatars (needed for some UI components)
      allow list: if isAuthenticated();
    }

    // User personal folder (avatars, covers, etc.)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.auth.uid == userId && validImage();
      allow delete, list: if isAuthenticated() && request.auth.uid == userId;
    }

    // Solution A: Allow public read for thumbnails generated by the extension
    match /thumbnails/{allPaths=**} {
      allow read: if true;
    }
  }
}
